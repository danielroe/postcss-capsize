{
  "name": "postcss-capsize",
  "version": "0.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "description": "PostCSS plugin to inject capsize font metrics",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://github.com/danielroe"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/postcss-capsize.git"
  },
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "font",
    "capsize",
    "metrics"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "!**/*.map",
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "pnpm eslint",
    "prepack": "tsdown",
    "prepare": "simple-git-hooks && pnpm build",
    "prepublishOnly": "pnpm lint && pnpm test",
    "test": "pnpm test:types && pnpm test:unit",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest"
  },
  "peerDependencies": {
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "@capsizecss/core": "^4.1.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yaml,yml}": [
      "pnpm eslint --fix"
    ]
  }
}
